{
  "routes": {},
  "applications": {
    "talk-to-your-document-agent": {
      "displayName": "Talk To Your Document Agent",
      "description": "Agent which can analyze, calculate and visualize data in document(s). Supported formats: xlsx, docx.",
      "endpoint": "http://host.docker.internal:5030/openai/deployments/talk-to-your-document-agent/chat/completions",
      "inputAttachmentTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ],
      "forwardAuthToken": true
    }
  },
  "models": {
    "qwen/qwen3-8b": {
      "displayName": "QwenLM",
      "endpoint": "http://host.docker.internal:1234/v1/chat/completions",
      "type": "chat"
    }
  },
  "keys": {
    "dial_api_key": {
      "project": "talk_to_your_document_agent_project",
      "role": "default"
    }
  },
  "roles": {
    "default": {
      "limits": {}
    }
  }
}
